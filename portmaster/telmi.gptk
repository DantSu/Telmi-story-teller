# Hotkey to kill app (SELECT+START)
# Note: "back" is the controller button that maps to SELECT
back_hotkey = back
start_hotkey = start

back = esc
start = return
select = backspace

a = z
b = x
x = s
y = a

l1 = q
r1 = w
l2 = minus
r2 = equals

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

right_analog_up = \"
right_analog_down = \"
right_analog_left = \"
right_analog_right = \"
